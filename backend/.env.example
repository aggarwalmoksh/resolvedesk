# Server-only values. Never prefix these with VITE_ and never place them in frontend/.env.
PORT=4000
FRONTEND_URL=http://localhost:5173
# Comma-separated allowed browser origins; include local Vite while developing.
CORS_ORIGIN=http://localhost:5173,https://your-frontend.example.com
PUBLIC_BASE_URL=https://your-public-backend.example.com

CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

TELEGRAM_BOT_TOKEN=your_telegram_bot_token
SECRET_TOKEN=your_telegram_webhook_fallback_secret
ENFORCE_SECRET_TOKEN=1
ECHO=0
